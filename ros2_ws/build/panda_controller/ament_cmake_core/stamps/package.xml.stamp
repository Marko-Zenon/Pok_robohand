<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>panda_controller</name>
  <version>0.0.1</version>
  <description>Controller for the Panda robot arm in Gazebo</description>
  <maintainer email="peleshko.pn@ucu.edu.ua">vboxuser</maintainer>
  <license>MIT</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS dependencies -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <!-- Robot control -->
  <depend>controller_manager</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>control_msgs</depend>
  <depend>sensor_msgs</depend>

  <!-- Gazebo integration -->
  <depend>gazebo_ros</depend>
  <depend>gazebo_msgs</depend>

  <!-- MoveIt or trajectory control (optional but common) -->
  <depend>trajectory_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- Linting tools -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

